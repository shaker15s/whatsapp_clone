rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Chat media - only participants who are authenticated
    match /chats/{chatId}/{allPaths=**} {
      // Validate file types (images, audio only)
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.contentType.matches('image/.*') ||
        request.resource.contentType.matches('audio/.*') ||
        request.resource.contentType.matches('video/.*');
      // File size limit: 10MB
      allow write: if request.auth != null &&
        request.resource.size < 10 * 1024 * 1024;
    }

    // Profile pictures - user can only upload their own
    match /profile_pics/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.contentType.matches('image/.*');
    }

    // Status media - user can only upload to their own folder
    match /statuses/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('video/.*'));
    }
  }
}
