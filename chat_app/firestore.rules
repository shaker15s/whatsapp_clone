rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isParticipant(chatId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function isValidString(v) {
      return v is string && v.size() >= 0 && v.size() <= 1000;
    }

    // ─── Users ───────────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone logged-in can read, but sensitive fields are restricted by the rules logic below
      allow read: if request.auth != null;

      // Users can ONLY write to their own document
      allow write: if isOwner(userId);

      // Field-level validation on writes
      allow update: if isOwner(userId) &&
        isValidString(request.resource.data.name) &&
        isValidString(request.resource.data.about) &&
        isValidString(request.resource.data.phoneNumber) &&
        request.resource.data.uid == userId;

      // Only allow setting fcmToken, twoStepPin, profilePicUrl for self
      allow update: if isOwner(userId) &&
        request.resource.data.fcmToken is string &&
        request.resource.data.twoStepPin is string;
    }

    // ─── Chats ──────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      // Only participants can create chats (and must include themselves)
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() >= 2;

      // Participants can update (archive, pin, unreadCount)
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);

        allow create: if isParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.type is string &&
          request.resource.data.content is string;

        allow update: if isParticipant(chatId);

        allow delete: if isParticipant(chatId);
      }
    }

    // ─── Calls ──────────────────────────────────────────────────────
    match /calls/{callId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.calleeId);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.callerId;

      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.calleeId);

      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.calleeId);
    }

    // ─── Status ─────────────────────────────────────────────────────
    match /status/{statusId} {
      // Anyone logged-in can read statuses
      allow read: if request.auth != null;
      // Users can only create their own status
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
    }
  }
}
