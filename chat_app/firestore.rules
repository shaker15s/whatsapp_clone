rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // اليوزرز: أي حد Logged-in يقدر يقرأ (عشان البحث بالـ username)
    // بس مش يقدر يعدل غير بروفايله هو بس
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // الشاتات: بس الطرفين المشاركين في المحادثة يقدروا يشوفوها
    match /chats/{chatId} {
      allow read, write: if request.auth != null &&
                          request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
                    request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if request.auth != null &&
                            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // المكالمات: بس الطرفين (المتصل والمتلقي)
    match /calls/{callId} {
      allow read, write: if request.auth != null &&
                          (request.auth.uid == resource.data.callerId ||
                           request.auth.uid == resource.data.calleeId);
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.callerId;
    }
  }
}
